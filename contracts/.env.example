# Copy this file to .env and fill it in.
#
#     cp .env.example .env
#
# .env is gitignored and must NEVER be committed.
# Notice there is no private key below — that is deliberate. See DEPLOY.md.

# ---------------------------------------------------------------------------
# Network
# ---------------------------------------------------------------------------
# Your Base Sepolia endpoint from Alchemy, Infura, or similar. Free tier is fine.
BASE_SEPOLIA_RPC=https://base-sepolia.g.alchemy.com/v2/YOUR_KEY_HERE

# ---------------------------------------------------------------------------
# Deployment
# ---------------------------------------------------------------------------
# The address that will own the contract — the "box office." Only this address
# can mint tickets or check attendees in. Leave blank to use the deploying
# wallet, which is normally right for testnet.
TICKLORE_OWNER=

# ---------------------------------------------------------------------------
# After deployment
# ---------------------------------------------------------------------------
# Filled in once Deploy.s.sol prints your contract address.
TICKLORE_CONTRACT=

# Optional: who receives the demo ticket. Blank = the wallet running the script.
TICKLORE_RECIPIENT=

# ---------------------------------------------------------------------------
# Contract verification (optional but recommended)
# ---------------------------------------------------------------------------
# Verifying publishes your source code to the block explorer so anyone can read
# it. For an investor conversation this matters: it turns "trust me" into
# "read it yourself."
# Free key from https://etherscan.io/myapikey
#
# NOTE: get this from etherscan.io, NOT basescan.org. Etherscan moved to a
# single multi-chain V2 key that covers Basescan, Arbiscan, Polygonscan and
# the rest. Legacy per-explorer keys are rejected with "Invalid API key".
ETHERSCAN_API_KEY=
