# ---------------------------------------------------------------------------
# Ticklore mint service
#
# Copy this file to .env and fill it in.  .env is gitignored — never commit it.
# ---------------------------------------------------------------------------

# Which network to talk to.
#   Base Sepolia (testnet) : https://sepolia.base.org
#   Local test chain       : http://127.0.0.1:8545
RPC_URL=https://sepolia.base.org

# The deployed TickloreTicket contract.
TICKLORE_CONTRACT=

# ---------------------------------------------------------------------------
# Signing — pick ONE.
# ---------------------------------------------------------------------------

# PREFERRED. The name of the encrypted Foundry keystore holding the owner key,
# created with:  cast wallet import tickloreDeployer --interactive
# The password is typed at runtime; no key is ever written to disk in plain text.
KEYSTORE_NAME=tickloreDeployer

# LOCAL TEST CHAINS ONLY. A raw private key in a file is exactly the thing this
# project avoids everywhere else. Use it with anvil, where every key is public
# knowledge anyway, and never with a wallet holding anything real.
# MINTER_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Server (server.js only)
# ---------------------------------------------------------------------------

# Shared secret required on POST /mint. Anything that can mint tickets is a
# money printer; the endpoint refuses every request if this is unset.
# Generate one with:  openssl rand -hex 32
MINT_API_KEY=

# Port for the local server. Bound to 127.0.0.1 — not reachable from outside
# this machine, deliberately.
PORT=3000
